# =============================================================================
# AegisGraph AI - Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development:
#   Copy-Item .env.example .env
#
# Never commit .env. Replace every CHANGE_ME value before running the API.
# Generate independent secrets; never reuse one key for multiple purposes.
#
# PowerShell secret examples:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=AegisGraph AI
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SERVICE_INSTANCE_ID=local-api-1
DEFAULT_TIMEZONE=UTC

# Fail application startup when placeholder secrets are present.
ENFORCE_SECURE_CONFIGURATION=true

# -----------------------------------------------------------------------------
# HTTP Server and Browser Security
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
WORKERS=1
REQUEST_TIMEOUT_SECONDS=15
REQUEST_MAX_BYTES=1048576

# JSON arrays are parsed by pydantic-settings.
CORS_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# Requests above these limits receive HTTP 429.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# The values below are local-development defaults, not deployment credentials.
POSTGRES_DB=aegisgraph
POSTGRES_USER=aegisgraph
POSTGRES_PASSWORD=aegisgraph_dev_only
DATABASE_URL=postgresql+asyncpg://aegisgraph:aegisgraph_dev_only@localhost:5432/aegisgraph
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=aegisgraph:development
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=50

# Retention for idempotency and short-lived fraud features.
IDEMPOTENCY_TTL_SECONDS=86400
FEATURE_CACHE_TTL_SECONDS=3600
SESSION_REVOCATION_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# Apache Kafka
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=["localhost:9092"]
KAFKA_CLIENT_ID=aegisgraph-api
KAFKA_CONSUMER_GROUP=aegisgraph-fraud-scorers
KAFKA_TRANSACTION_TOPIC=payments.transactions.v1
KAFKA_ALERT_TOPIC=fraud.alerts.v1
KAFKA_DEAD_LETTER_TOPIC=payments.transactions.dlq.v1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=500
KAFKA_REQUEST_TIMEOUT_MS=5000

# Optional values for secured Kafka deployments.
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# -----------------------------------------------------------------------------
# Neo4j Fraud Graph
# -----------------------------------------------------------------------------
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_SECONDS=3
NEO4J_QUERY_TIMEOUT_SECONDS=2
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_MAX_TRAVERSAL_DEPTH=4
NEO4J_MAX_RESULT_RECORDS=500

# -----------------------------------------------------------------------------
# Authentication and Authorization
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_GENERATE_AN_INDEPENDENT_64_BYTE_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=aegisgraph-ai
JWT_AUDIENCE=aegisgraph-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CLOCK_SKEW_SECONDS=30

# Password policy and Argon2 limits.
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=true
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# -----------------------------------------------------------------------------
# Privacy-Preserving Identity Vault
# -----------------------------------------------------------------------------
# Generate the Fernet key with the command documented at the top of this file.
IDENTITY_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY
IDENTITY_ENCRYPTION_KEY_ID=local-key-v1

# Generate a separate HMAC key for deterministic, scoped identity tokens.
IDENTITY_HMAC_KEY=CHANGE_ME_GENERATE_AN_INDEPENDENT_64_BYTE_SECRET
IDENTITY_TOKEN_NAMESPACE=aegisgraph-development
ALLOW_IDENTITY_DETOKENIZATION=false
IDENTITY_ACCESS_PURPOSE_REQUIRED=true

# -----------------------------------------------------------------------------
# Fraud Rules and Hybrid Risk Aggregation
# -----------------------------------------------------------------------------
RULES_SCORE_WEIGHT=0.35
ML_SCORE_WEIGHT=0.30
GRAPH_SCORE_WEIGHT=0.25
IDENTITY_SCORE_WEIGHT=0.10

REVIEW_THRESHOLD=0.55
BLOCK_THRESHOLD=0.82
MIN_DECISION_CONFIDENCE=0.60

HIGH_VALUE_AMOUNT=50000
VELOCITY_WINDOW_SECONDS=300
VELOCITY_MAX_TRANSACTIONS=8
DISTANCE_IMPOSSIBLE_SPEED_KMH=900
NEW_DEVICE_RISK_WINDOW_HOURS=24

# A partial score must identify unavailable signals in its explanation.
ALLOW_DEGRADED_SCORING=true
DEGRADED_SCORING_MAX_RISK=0.80

# -----------------------------------------------------------------------------
# Machine Learning
# -----------------------------------------------------------------------------
ML_MODEL_PATH=artifacts/fraud_model.joblib
ML_MODEL_METADATA_PATH=artifacts/fraud_model.metadata.json
ML_MODEL_VERSION=untrained
ML_FEATURE_SCHEMA_VERSION=1.0.0
ML_ARTIFACT_SHA256=CHANGE_ME_AFTER_TRAINING
ML_PREDICTION_TIMEOUT_MS=100
ML_MAX_BATCH_SIZE=256
ML_RANDOM_SEED=42

# Only enable explanations after a compatible model artifact is available.
ENABLE_SHAP_EXPLANATIONS=false
SHAP_MAX_BACKGROUND_ROWS=500

# -----------------------------------------------------------------------------
# Audit, Logging, Metrics, and Tracing
# -----------------------------------------------------------------------------
AUDIT_LOG_ENABLED=true
AUDIT_HASH_CHAIN_ENABLED=true
AUDIT_FAIL_CLOSED=true
LOG_FORMAT=json
LOG_REDACTION_ENABLED=true
LOG_INCLUDE_SOURCE=false

METRICS_ENABLED=true
METRICS_PATH=/metrics
PROMETHEUS_MULTIPROC_DIR=
TRACING_ENABLED=false
OTEL_SERVICE_NAME=aegisgraph-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------
# Data Lifecycle
# -----------------------------------------------------------------------------
TRANSACTION_RETENTION_DAYS=365
ALERT_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=2555
IDENTITY_RETENTION_DAYS=365
ENABLE_RETENTION_JOBS=false

# Synthetic data is mandatory for this educational prototype.
ALLOW_REAL_CUSTOMER_DATA=false
SYNTHETIC_DATA_SEED=42

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_RULES_ENGINE=true
ENABLE_ML_ENGINE=false
ENABLE_GRAPH_ENGINE=false
ENABLE_IDENTITY_RISK=false
ENABLE_KAFKA_INGESTION=false
ENABLE_ANALYST_DETOKENIZATION=false
